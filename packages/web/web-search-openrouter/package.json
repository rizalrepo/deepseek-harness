{
  "name": "@deepseek-ai/dsh-web-search-openrouter",
  "description": "OpenRouter Responses API web search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
